# ====== .env ======

# Общие настройки
NODE_ENV=production
COMPOSE_PROJECT_NAME=socialnet

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socialnet
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Бэкенд (Порт перенаправлен на 4000, чтобы не занимать 3000 и 2222)
BACKEND_PORT=4000
BACKEND_HOST=backend

# Безопасность
JWT_SECRET=super_secret_socialnet_jwt_key_2025
ADMIN_EMAILS=admin@example.com
AI_API_KEYS=ai_key_1,ai_key_2

# Режим деплоя
DEPLOYMENT_MODE=single-server

# Миграции
AUTO_MIGRATE=true

# Фронтенд (URL вашего бэкенда на VPS)
EXPO_PUBLIC_API_URL=http://132.243.235.23:4000
VITE_API_URL=http://132.243.235.23:4000
VITE_WS_URL=ws://132.243.235.23:4000
VITE_APP_NAME=SocialNet

# Разрешённые CORS домены
ALLOWED_ORIGINS=*
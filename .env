# ====== .env ======

# Общие настройки
NODE_ENV=production
COMPOSE_PROJECT_NAME=socialnet

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socialnet
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Бэкенд
BACKEND_PORT=3000
BACKEND_HOST=backend

# Безопасность
JWT_SECRET=your_super_secret_key_here
ADMIN_EMAILS=admin@example.com
AI_API_KEYS=ai_key_1,ai_key_2

# Режим деплоя
DEPLOYMENT_MODE=single-server

# Миграции
AUTO_MIGRATE=true

# Фронтенд (для сборки)
VITE_API_URL=http://backend:3000
VITE_WS_URL=ws://backend:3000
VITE_APP_NAME=SocialNet
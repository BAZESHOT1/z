# ====== .env ======

# Общие настройки
NODE_ENV=production
COMPOSE_PROJECT_NAME=socialnet

# База данных (Порт 5435 наружу, 5432 внутри контейнера)
POSTGRES_USER=zzzz
POSTGRES_PASSWORD=sAMogyg6sAMogyg
POSTGRES_DB=zzzz
POSTGRES_PORT=5435

# Redis
REDIS_PORT=6453

# Бэкенд
BACKEND_PORT=4000
BACKEND_HOST=backend

# Безопасность
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
ADMIN_EMAILS=admin@example.com
AI_API_KEYS=ai_key_1,ai_key_2

# ====== НАСТРОЙКИ MESH-СЕТИ (P2P CLUSTER) ======
# Если true — эта нода является мастер-нодой сети
IS_MASTER_NODE=true
# Уникальный идентификатор этой ноды в сети
NODE_ID=zzz
# Секретный ключ авторизации между нодами в кластере
CLUSTER_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
# URL центральной ноды (заполняется для ведомых нод, например: http://132.243.235.23:4000)
MASTER_NODE_URL=

# Режим деплоя
DEPLOYMENT_MODE=cluster

# Миграции
AUTO_MIGRATE=true

# Фронтенд (URL вашего бэкенда на VPS)
EXPO_PUBLIC_API_URL=http://132.243.235.23:4000
VITE_API_URL=http://132.243.235.23:4000
VITE_WS_URL=ws://132.243.235.23:4000
VITE_APP_NAME=SocialNet

# Разрешённые CORS домены
ALLOWED_ORIGINS=*
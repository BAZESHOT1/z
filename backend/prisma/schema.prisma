generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  username        String     @unique
  email           String     @unique
  password        String
  firstName       String?
  lastName        String?
  avatar          String?
  bio             String?
  socialLinks     String?
  birthDate       String?
  role            String     @default("USER") // USER, MODERATOR, ADMIN, ROOT
  privacyProfile  String     @default("EVERYONE")
  privacyMessages String     @default("EVERYONE")
  privacyPosts    String     @default("EVERYONE")
  createdAt       DateTime   @default(now())
  posts           Post[]
  miniApps        MiniApp[]
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}

model MiniApp {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  url         String
  icon        String?
  category    String   @default("UTILITY")
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
}

model EncryptionKey {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())
}
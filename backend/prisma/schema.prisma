generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  username        String     @unique
  email           String?    @unique
  password        String
  firstName       String?
  lastName        String?
  bio             String?
  avatar          String?
  socialLinks     String?
  birthDate       String?
  role            String     @default("USER")
  privacyProfile  String     @default("EVERYONE")
  privacyMessages String     @default("EVERYONE")
  privacyPosts    String     @default("EVERYONE")
  nodeId          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  posts           Post[]     @relation("UserPosts")
  likes           Like[]     @relation("UserLikes")
  comments        Comment[]  @relation("UserComments")
  followedBy      Follow[]   @relation("UserFollowedBy")
  following       Follow[]   @relation("UserFollowing")
  miniApps        MiniApp[]  @relation("UserMiniApps")
}

model Post {
  id         Int       @id @default(autoincrement())
  content    String
  mediaUrl   String?
  viewsCount Int       @default(0)
  isEdited   Boolean   @default(false)
  authorId   Int
  author     User      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  likes      Like[]    @relation("PostLikes")
  comments   Comment[] @relation("PostComments")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  authorId  Int
  postId    Int
  author    User     @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model MiniApp {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  url         String
  icon        String?
  authorId    Int
  author      User     @relation("UserMiniApps", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model EncryptionKey {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())
}
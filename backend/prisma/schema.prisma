generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String        // Зашифрованный хэш пароля
  firstName    String
  lastName     String?
  role         String        @default("user") // user, root, admin, moderator, tester, helper
  status       String        @default("offline") // online, offline
  bio          String?       // Зашифрованное описание профиля (до 256 символов)
  socialLinks  String?       // Зашифрованные ссылки на соцсети (JSON string)
  avatar       String?
  birthDate    String?       // Зашифрованная дата рождения
  lastSeen     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  posts        Post[]
  likes        Like[]
}

model Post {
  id        String   @id @default(uuid())
  content   String
  imageUrl  String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  likes     Like[]
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model ClusterNode {
  id             String   @id @default(uuid())
  nodeId         String   @unique
  url            String
  status         String   @default("active")
  isMaster       Boolean  @default(false)
  nodeType       String   @default("full") // "full" (Основной узел) или "replica" (Репликационная нода)
  lastSeen       DateTime @default(now())
  dbSyncProgress Int      @default(100)
}